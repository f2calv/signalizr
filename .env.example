# Copy to .env and supply real values. .env is gitignored - it holds personal data.
#
# The Signal account the gateway sends from, in E.164 format. This is personal data: it must never
# be committed, logged, or placed in a chart values file.
SIGNALIZR_PHONE_NUMBER=+10000000000

# Preserve existing registrations when moving from the former PostgreSQL-only Compose project.
# Leave unset for the original SQLite project or a fresh setup.
# SIGNALIZR_ACCOUNT_VOLUME=signalizr-postgres_signal-cli-data
