{
  "CasCap": {
    "FeatureConfig": {
      "EnabledFeatures": "Gateway,Receiver"
    },
    "SignalCliConfig": {
      "BaseAddress": "http://localhost:8180",
      "PhoneNumber": "+10000000000"
    },
    "ChannelConfig": {
      "Channels": {
        "system": "CasCap.Signalizr System",
        "demo": "CasCap.Signalizr Demo"
      }
    },
    "ReceiverConfig": {
      "QueueCapacity": 1000
    },
    "SubscriberConfig": {
      "QueueCapacity": 100,
      "MaxOutstanding": 32,
      "AckTimeoutMs": 30000
    },
    "GrpcHostConfig": {
      "Http1Port": 8080,
      "Http2Port": 5001
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
