{
  "CasCap": {
    "FeatureConfig": {
      "EnabledFeatures": "Gateway,Receiver"
    },
    "McpConfig": {
      "MessageHistoryEnabled": false,
      "MessageSendingEnabled": false
    },
    "SignalCliConfig": {
      "BaseAddress": "http://localhost:8180",
      "PhoneNumber": "+10000000000"
    },
    "GroupConfig": {
      "GroupNames": []
    },
    "GatewayConfig": {
      "ProfileName": null,
      "SendRateWarningPerMinute": 30
    },
    "OperatorNotificationConfig": {
      "NotificationsEnabled": false,
      "QueueCapacity": 100,
      "ThrottleNoticeIntervalMs": 60000
    },
    "DatabaseConfig": {
      "ConnectionString": "Data Source=/var/lib/signalizr/signalizr.db"
    },
    "CachingConfig": {
      "RemoteCacheConnectionString": "localhost:6379,abortConnect=false,connectTimeout=1000",
      "RemoteCache": {
        "SerializationType": "Json"
      }
    },
    "CommsConfig": {
      "GroupName": "My Test Group Name",
      "MonitorGroupName": null,
      "MonitorContentEnabled": false,
      "EchoTranscriptToDebugChat": false,
      "StreamConsumptionEnabled": false,
      "AgentName": "CommsAgent",
      "AgentSessionId": "primary-group"
    },
    "CommsMetricsConfig": {
      "MetricNamePrefix": "signalizr"
    },
    "VoiceMetricsConfig": {
      "MetricNamePrefix": "signalizr"
    },
    "SpeechToTextConfig": {
      "Mode": "Disabled"
    },
    "TextToSpeechConfig": {
      "Mode": "Disabled"
    },
    "AgentRuntimeClientOptions": {
      "BaseAddress": "http://localhost:5090",
      "TimeoutMinutes": 10
    },
    "AgentRuntimeAzureAuthConfig": {
      "Enabled": false,
      "TenantId": null,
      "ClientId": null,
      "Certificate": null,
      "Scope": null
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "ModelContextProtocol": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
