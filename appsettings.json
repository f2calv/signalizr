{
    "CasCap": {
        "FeatureConfig": {
            "EnabledFeatures": "Gateway,Receiver"
        },
        "SignalCliConfig": {
            "BaseAddress": "http://localhost:8180",
            "PhoneNumber": "+10000000000"
        },
        "ChannelConfig": {
            "Channels": {}
        },
        "GatewayConfig": {
            "ProfileName": null,
            "SendRateWarningPerMinute": 30
        },
        "OperatorNotificationConfig": {
            "NotificationsEnabled": false,
            "QueueCapacity": 100,
            "ThrottleNoticeIntervalMs": 60000
        },
        "DatabaseConfig": {
            "ConnectionString": "Data Source=/var/lib/signalizr/signalizr.db"
        }
    },
    "Serilog": {
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning"
            }
        }
    },
    "AllowedHosts": "*"
}